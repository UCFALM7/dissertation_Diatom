library(rbacon)

# =========================================================
# Liu et al. testate-amoeba chronology
# 11 radiocarbon dates + AD 2012 surface
# IntCal13 calibration
# =========================================================

core <- "TRIU_Liu_Testate"
root <- file.path(getwd(), "Bacon_runs")
folder <- file.path(root, core)

# IntCal13 file supplied with rintcal
curve_dir <- system.file("extdata", package = "rintcal")
curve_file <- "3Col_intcal13.14C"

if (!file.exists(file.path(curve_dir, curve_file))) {
  stop("The IntCal13 calibration-curve file was not found.")
}

# Remove any earlier run with the same name
if (dir.exists(folder)) {
  unlink(folder, recursive = TRUE, force = TRUE)
}

dir.create(folder, recursive = TRUE, showWarnings = FALSE)

# ---------------------------------------------------------
# Chronological controls
# ---------------------------------------------------------

dates <- data.frame(
  "lab ID" = c(
    "Core_surface",
    "368996",
    "330145",
    "368997",
    "368998",
    "369001",
    "368999",
    "369000",
    "369002",
    "369003",
    "369004",
    "330146"
  ),
  
  Age = c(
    -62,       # AD 2012 expressed as cal BP
    90,
    410,
    480,
    570,
    730,
    830,
    1070,
    1580,
    1810,
    3970,
    4430
  ),
  
  Error = c(
    1,         # practical uncertainty for the known surface year
    30,
    30,
    30,
    30,
    30,
    30,
    30,
    30,
    30,
    30,
    40
  ),
  
  Depth = c(
    0,
    54,
    100,
    119,
    154,
    188,
    208,
    284,
    353,
    384,
    578,
    700
  ),
  
  # cc=0: age already expressed in calendar BP
  # cc=4: use the alternative IntCal13 curve
  cc = c(
    0,
    rep(4, 11)
  ),
  
  check.names = FALSE
)

write.csv(
  dates,
  file.path(folder, paste0(core, ".csv")),
  row.names = FALSE,
  quote = FALSE
)

# ---------------------------------------------------------
# Run the Bacon model
# ---------------------------------------------------------

Bacon(
  core = core,
  coredir = root,
  
  # Alternative calibration curve
  cc4 = curve_file,
  cc.dir = curve_dir,
  
  # Model entire core at 1-cm output resolution
  d.min = 0,
  d.max = 700,
  d.by = 1,
  thick = 5,
  
  # Bacon defaults used before the 2021 update
  acc.shape = 1.5,
  acc.mean = 20,
  mem.strength = 4,
  mem.mean = 0.7,
  ssize = 2000,
  cutoff = 0.001,
  
  seed = 2019,
  remember = FALSE,
  suggest = FALSE,
  ask = FALSE,
  plot.pdf = FALSE
)
