# Reconstruct the Triunfo peat-core age-depth model used by
# Liu et al. (2019, Quaternary Research 92:14-32).
#
# Paper-specific choices retained:
#   * eleven bulk-peat AMS 14C dates at the depths reported in Table 4;
#   * the 2012 core-top calendar control explicitly stated in the methods;
#   * model extent 0-700 cm;
#   * Bacon's pre-2021 default priors and 5-cm sections;
#   * IntCal13, explicitly reported by the paper;
#   * no tephra age, boundary, hiatus, reservoir correction, or other
#     chronological control was added.
#
# The top was collected in 2012, equivalent to -62 cal BP (1950 datum).
# Current rbacon requires a positive error for calendar dates, so 1 year is
# used as the numerical representation of the known collection-year surface.
#
# Modern rbacon no longer maps cc=1 to IntCal13. This script writes IntCal13
# as a three-column custom curve and uses cc=4.

library("rbacon")

script_directory <- function() {
  args <- commandArgs(trailingOnly = FALSE)
  file_arg <- grep("^--file=", args, value = TRUE)
  if (length(file_arg) > 0L) {
    return(dirname(normalizePath(sub("^--file=", "", file_arg[1L]))))
  }
  normalizePath(getwd())
}

make_custom_intcal13 <- function(curve_dir) {
  dir.create(curve_dir, recursive = TRUE, showWarnings = FALSE)
  suppressMessages(rintcal::new.ccdir(curve_dir))
  curve <- rintcal::ccurve("IntCal13")
  curve <- as.data.frame(curve[, 1:3, drop = FALSE])
  names(curve) <- c("cal_BP", "C14_age_BP", "curve_error")
  curve_file <- file.path(curve_dir, "IntCal13_custom.14C")
  write.table(
    curve,
    file = curve_file,
    sep = "\t",
    row.names = FALSE,
    col.names = FALSE,
    quote = FALSE
  )
  curve_file
}

clean_previous_run <- function(core_folder) {
  if (!dir.exists(core_folder)) return(invisible(NULL))
  candidates <- list.files(core_folder, full.names = TRUE)
  generated <- grepl(
    "\\.(bacon|out|pdf|plum)$|_ages\\.txt$|_settings\\.txt$|_accrates\\.txt$|_elbowages\\.txt$|\\.init$",
    basename(candidates),
    ignore.case = TRUE
  )
  unlink(candidates[generated], force = TRUE)
  invisible(NULL)
}

standardise_age_summary <- function(x) {
  x <- as.data.frame(x)
  if (ncol(x) < 5L) stop("Unexpected output from rbacon::ageranges().")
  x <- x[, 1:5, drop = FALSE]
  names(x) <- c(
    "depth_cm", "age_min95_calBP", "age_max95_calBP",
    "age_median_calBP", "age_mean_calBP"
  )
  x
}

accumulation_summary <- function(depths, model) {
  out <- t(vapply(
    depths,
    function(d) {
      as.numeric(rbacon::accrate.depth.summary(
        d = d, set = model, cmyr = FALSE, na.rm = TRUE
      ))
    },
    numeric(6L)
  ))
  out <- as.data.frame(out)
  names(out) <- c(
    "accum_min95_yr_per_cm", "accum_min68_yr_per_cm",
    "accum_max68_yr_per_cm", "accum_max95_yr_per_cm",
    "accum_median_yr_per_cm", "accum_mean_yr_per_cm"
  )
  cbind(depth_cm = depths, out)
}

